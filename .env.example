# Copie para .env.local e preencha os valores reais. Nunca faça commit deste ficheiro.

# Chave da API do Google Gemini (obtém em https://aistudio.google.com)
GEMINI_API_KEY=sua_chave_aqui

# Segredo para assinar cookies de sessão do admin (gera com: openssl rand -base64 32)
ADMIN_SESSION_SECRET=seu_segredo_aqui

# Palavra-passe do admin em base64 (gera com: node scripts/hash-password.js "sua senha")
ADMIN_PASSWORD_HASH=sua_senha_em_base64_aqui
